.next/
# Isolated build cache + tsconfig of the smoke Playwright web server, so its
# `next dev` rewrites neither `.next` nor the tracked tsconfig.json
# (NEXT_DIST_DIR / NEXT_TSCONFIG_PATH — see playwright.smoke.config.ts).
.next-smoke/
tsconfig.smoke.json

# Playwright
e2e/.auth/
playwright-report/
test-results/
e2e-results.json
e2e-results.xml

# Coverage
.nyc_output/
coverage-e2e/

# Fonts (downloaded at build time)
public/fonts/*.ttf
public/fonts/*.otf
public/fonts/*.woff
public/fonts/*.woff2
# Google Sans woff2 files (downloaded at build time, not checked in)
public/fonts/google-sans/
